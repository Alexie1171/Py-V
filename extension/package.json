{
  "name": "py-v",
  "displayName": "V — local coding assistant",
  "description": "Chat with V, your local AI assistant (IBM Granite + LoRA), inside VS Code. Needs the Py-V server running.",
  "version": "0.1.0",
  "publisher": "Alexie1171",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "python",
    "ai",
    "code generation",
    "copilot",
    "local"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onView:pyv.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pyv.generate",
        "title": "PY-V: Generate Code from Selection"
      },
      {
        "command": "pyv.generateFromInput",
        "title": "PY-V: Generate Code from Prompt"
      },
      {
        "command": "pyv.checkServer",
        "title": "PY-V: Check Server Status"
      },
      {
        "command": "pyv.openChat",
        "title": "V: Open Chat"
      }
    ],
    "keybindings": [
      {
        "command": "pyv.generate",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "pyv.generateFromInput",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && editorLangId == python"
      }
    ],
    "configuration": {
      "title": "PY-V",
      "properties": {
        "pyv.projectSearch": {
          "type": "boolean",
          "default": true,
          "description": "Let V search your workspace folder's code when a question is about the project. The index stays on this computer (Py-V data/projects)."
        },
        "pyv.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the PY-V inference server."
        },
        "pyv.maxTokens": {
          "type": "number",
          "default": 256,
          "minimum": 16,
          "maximum": 1024,
          "description": "Maximum number of tokens to generate."
        },
        "pyv.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Sampling temperature. Lower = more deterministic."
        },
        "pyv.manageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start V's server when the V panel opens, and stop it after the panel has been closed for a while (pyv.stopServerAfterSeconds). A server you started yourself is never stopped."
        },
        "pyv.stopServerAfterSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "How long the V panel must stay closed before V's server stops (frees RAM and the GPU). 0 = right away."
        },
        "pyv.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python that runs V's server (python -m uvicorn inference.api.main:app)."
        },
        "pyv.projectPath": {
          "type": "string",
          "default": "",
          "description": "The Py-V folder (the one with inference/api/main.py). Empty = the open workspace folder that has it."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pyv",
          "title": "V",
          "icon": "media/v.svg"
        }
      ]
    },
    "views": {
      "pyv": [
        {
          "type": "webview",
          "id": "pyv.chatView",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "install-local": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license --out v.vsix && code --install-extension v.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
