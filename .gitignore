# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Bytecode
*.pyc

# Virtual environments
venv/
env/
.venv/

# HuggingFace cache
.cache/
hf_cache/

# OS files
.DS_Store
Thumbs.db

# Logs and experiments
experiments/logs/
experiments/outputs/

# Model weights — LoRA adapters (model/lora, model/lora_*) and downloads.
# Brains themselves live in the Hugging Face cache, never in the repo.
model/lora*/
model_t4/
Drive downloads/
Kaggle downloads/

# Private conversations — V's memory database (Phase 11) and old session files
data/memory/
sessions/
Google Colab/

# ── PY-V specific ──────────────────────

# Raw scraped data (large, reproducible, don't commit)
data/raw/

# Processed intermediates (reproducible from raw)
data/processed/

# Final datasets (large binary-ish files)
data/datasets/

# Pipeline log
data/pipeline.log

# RAG index (rebuild with: python -m retrieval.indexer)
retrieval/index/

# API keys / secrets (never commit these)
.env
*.env
kaggle.json

# VS Code extension build artifacts
extension/node_modules/
extension/out/
extension/dist/